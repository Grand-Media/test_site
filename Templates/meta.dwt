<!DOCTYPE html>
<html lang="ja">
<!-- TemplateParam name="INNER_META" type="boolean" value="true" -->
<!-- TemplateParam name="PAGENAME_JA" type="text" value="コンセプト" -->
<!-- TemplateParam name="KEYWORD" type="text" value="@@(PAGENAME_JA)@@" -->
<!-- TemplateParam name="DESCRIPTION" type="text" value="@@(PAGENAME_JA)@@" -->
<!-- TemplateParam name="PAGENAME_EN" type="text" value="concept" -->
<!-- TemplateParam name="CANONICAL" type="text" value="@@(PAGENAME_EN)@@/" -->
<head>
<meta http-equiv="content-Type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width,user-scalable=yes,maximum-scale=3.0">
<!-- メタタグ ここから -->
<!-- TemplateBeginIf cond="_document['INNER_META']" --><!-- 下層用META -->
<title>@@(PAGENAME_JA)@@｜[title]</title>
<meta name="keywords" content="@@(KEYWORD)@@,○○○○○○○○○" />
<meta name="description" content="○○○○○○○○○の@@(DESCRIPTION)@@ページ" />
<!-- <link rel="canonical" href="https://○○○.○○○/○○○/@@(CANONICAL)@@">	-->
<!-- TemplateEndIf -->
<!-- TemplateBeginIf cond="!_document['INNER_META']" --><!-- トップ用META -->
<title>[title]</title>
<meta name="keywords" content="○○○○○○○○○" />
<meta name="description" content="○○○○○○○○○" />
<!-- <link rel="canonical" href="https://○○○.○○○/○○○/"> -->
<!-- TemplateEndIf -->
<!-- メタタグ ここまで -->
	
<!-- CSS/JS ここから -->
<!--	YAKUHAN	Noto_serif	Noto_sans	-->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/yakuhanjp@4.0.0/dist/css/yakuhanmp.css" />
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/yakuhanjp@4.0.0/dist/css/yakuhanjp.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@400;500;600;700&display=swap" rel="stylesheet">	
<!--	YAKUHAN	Noto_serif	Noto_sans	-->

<link rel="stylesheet" type="text/css" href="../css/common.css" />
<script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.3.0/jquery.min.js"></script>
<script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jQuery-rwdImageMaps/1.6/jquery.rwdImageMaps.min.js"></script>
<script type="text/javascript" src="../js/util.js"></script>
	
<script type="text/javascript" src="../js/SmoothScroll.js"></script>	
<!-- TemplateBeginEditable name="head" -->
<!-- TemplateEndEditable -->
<!-- CSS/JS ここまで -->
	
<!-- 解析タグ(head内) ここから -->
	
<!-- 解析タグ(head内) ここまで -->
</head>
<body id="@@(PAGENAME_EN)@@">
	
<!-- 解析タグ(body開始直後) ここから -->
	
<!-- 解析タグ(body開始直後) ここまで -->
	
	<!-- TemplateBeginIf cond="_document['INNER_META']" --><!-- 下層用META -->
	<h1>@@(PAGENAME_JA)@@｜[title]</h1>
	<!-- TemplateEndIf -->
	<!-- TemplateBeginIf cond="!_document['INNER_META']" --><!-- トップ用META -->
	<h1>[title]</h1>
	<!-- TemplateEndIf -->
	
	<div class="wrap" id="pagetop">
	<!-- TemplateBeginEditable name="CONTENT" -->
	<!-- TemplateEndEditable -->
	</div>
	
	<!-- TemplateBeginEditable name="JS" -->
	<!-- TemplateEndEditable -->
	
<!-- 解析タグ(body終了直前) ここから -->
	
<!-- 解析タグ(body終了直前) ここまで -->
	
</body>
</html>